{
  "expo": {
    "name": "victory-fitness",
    "slug": "victora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "victoryfitness",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0B18"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Victory Fitness uses Face ID to unlock your existing signed-in session on this device.",
        "NSHealthShareUsageDescription": "Victory Fitness reads your health data to power Longevity OS insights and recovery tracking.",
        "NSHealthUpdateUsageDescription": "Victory Fitness writes health updates only when you choose to sync your wellness data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0B18"
      },
      "launchMode": "singleTask",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.victory.fitness",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-tab.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-health-connect",
      [
        "react-native-health",
        {
          "healthSharePermission": "Victory Fitness reads your Apple Health data to power Longevity OS insights and recovery tracking.",
          "healthUpdatePermission": "Victory Fitness writes health updates only when you choose to sync your wellness data."
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Victory Fitness uses Face ID to unlock your existing signed-in session on this device."
        }
      ]
    ],
    "extra": {
      "router": {},
      "googleHealthConnect": {
        "clientId": "664344615268-kjsk6iq3ae0stfuu025o6hsdp988cvrl.apps.googleusercontent.com",
        "projectId": "victoria-43064",
        "authUri": "https://accounts.google.com/o/oauth2/auth",
        "tokenUri": "https://oauth2.googleapis.com/token",
        "authProviderCertUrl": "https://www.googleapis.com/oauth2/v1/certs"
      },
      "eas": {
        "projectId": "b745c8ed-3483-4e3c-8c77-923cce1c5376"
      }
    },
    "owner": "miskat"
  }
}
